rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /challenges/{challengeId} {
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.ownerId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.ownerId;
    }

    match /dailyResults/{resultId} {
      allow read: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create, update: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
      // Delete has no request.resource (no incoming data), so it must check
      // the existing doc's owner instead — lets a user undo their own
      // accidental "Complete" click.
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }

    match /teams/{teamId} {
      // Any authenticated user can read a team's basic info (name) given its
      // ID — required so the join flow can show "Join {name}?" before the
      // requester becomes a member. Team IDs are random Firestore auto-IDs,
      // not enumerable, so this only matters to someone who already has a
      // valid invite link or is already a member; the leaderboard itself
      // (teamMembers) stays properly membership-gated.
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.ownerId;
    }

    // Read access allows either "this is my own row" (provable directly from
    // queries filtered by userId, e.g. "my teams") or "you're also a member
    // of this same team" (provable from queries filtered by teamId, e.g. a
    // team's leaderboard) — checked via the requester's own membership doc.
    // This is deliberately the only cross-user read in the schema, and only
    // exposes the denormalized progress snapshot on this collection, never
    // the member's private challenges/dailyResults directly.
    match /teamMembers/{memberId} {
      // `resource == null` (the doc doesn't exist, e.g. checking whether
      // you've already joined) must be checked first — Firestore rules
      // throw rather than short-circuit if `resource.data` is dereferenced
      // on a null resource, which would otherwise break "does my own
      // prospective membership doc exist yet" lookups during join.
      allow read: if request.auth != null
        && (resource == null
          || request.auth.uid == resource.data.userId
          || exists(/databases/$(database)/documents/teamMembers/$(resource.data.teamId + '_' + request.auth.uid)));
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }

    match /teamInvites/{code} {
      // Any authenticated user can resolve an invite code — that's the
      // point of a shareable link — but only its creator can create it.
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.createdBy;
    }

    match /notifications/{notificationId} {
      // No client `create` rule — these are only ever written by the
      // scheduled Cloud Function via the Admin SDK, which bypasses rules
      // entirely. Clients can only read their own and mark them read.
      allow read, update: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }

    match /activities/{activityId} {
      // The activity ledger behind Meaningful Mode progress. Strava
      // activities (IDs `strava_<id>`) are written only by our API routes
      // via the Admin SDK; clients may only add and delete their own
      // manual entries, and never edit one — a change is delete + re-add.
      allow read: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId
        && !activityId.matches('strava_.*')
        && request.resource.data.source == 'manual'
        && request.resource.data.type in ['run', 'walk', 'hike', 'ride', 'swim', 'wheelchair', 'other']
        && request.resource.data.distanceKm is number
        && request.resource.data.distanceKm >= 0
        && request.resource.data.distanceKm <= 1000
        && request.resource.data.durationMin is number
        && request.resource.data.durationMin > 0
        && request.resource.data.durationMin <= 1440
        && request.resource.data.localDate is string
        && request.resource.data.localDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.startLocal is string
        && request.resource.data.startLocal.matches('^' + request.resource.data.localDate + 'T.*');
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.userId
        && resource.data.source == 'manual';
    }

    match /fitnessConnections/{connectionId} {
      // Holds OAuth tokens for third-party fitness providers (Strava, etc).
      // Server-only: no client read/write at all — only our Vercel API
      // routes touch this, via the Admin SDK, which bypasses rules.
      allow read, write: if false;
    }
  }
}
