VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Set to "true" to connect to the local Firebase emulator suite (see `npm run emulators`)
VITE_USE_FIREBASE_EMULATOR=

# Strava API app (register at https://www.strava.com/settings/api)
VITE_STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Any random string; must match what's used when creating the Strava push subscription
STRAVA_WEBHOOK_VERIFY_TOKEN=
